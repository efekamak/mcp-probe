      "transport": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    {
      "id": "microsoft-learn-mcp",
      "name": "Microsoft Learn MCP",
      "package": "learn.microsoft.com/api/mcp",
